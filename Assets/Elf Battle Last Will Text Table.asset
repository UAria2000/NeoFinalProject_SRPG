  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d756f62a7ec4464999ba9bcb575c632, type: 3}
  m_Name: Elf Battle Last Will Text Table
  m_EditorClassIdentifier: Assembly-CSharp::BattleLastWillTextTable
  texts:
  - "\uC0C8 \uC18C\uB9AC\uAC00 \uC774\uB807\uAC8C \uBC18\uAC00\uC6B8 \uC904\uC774\uC57C\u2026
    \uBA70\uCE60 \uB0B4\uB0B4 \uC624\uD06C\uB4E4 \uACE0\uD568\uB9CC \uB4E4\uC5C8\uB354\uB2C8
    \uADC0\uAC00 \uB2E4 \uBA39\uBA39\uD574."
  - "\uBB3C \uC815\uB839\uC740 \uC774\uC81C \uC81C\uBC95 \uB2E4\uB8E8\uACA0\uB294\uB370\u2026
    \uB2E4\uC74C\uC5D4 \uBD88 \uC815\uB839\uC744 \uBD88\uB7EC\uBCFC\uAE4C? \uD3ED\uBC1C\uD558\uB294\uAC74
    \uC544\uB2C8\uACA0\uC9C0?"
  - "\uAF43 \uC880 \uBC1F\uC558\uB2E4\uACE0 \uADF8\uB807\uAC8C\uAE4C\uC9C0 \uD63C\uB0A0
    \uC77C\uC774\uC57C? \uC232\uC5D0 \uB110\uB9B0 \uAC8C \uAF43\uC778\uB370\u2026"
  - "\uC544\u2026 \uC624\uB298\uC740 \uC815\uB9D0 \uC544\uBB34\uAC83\uB3C4 \uD558\uAE30
    \uC2EB\uB2E4. \uD558\uB8E8 \uC885\uC77C \uC6C0\uC9C1\uC600\uB294\uB370 \uB2EC\uB77C\uC9C4
    \uAC74 \uD558\uB098\uB3C4 \uC5C6\uB124."
  - "\uC544\uC774\uB294 \uB208 \uC0C9\uC774 \uB204\uAD6C\uB97C \uB2EE\uC73C\uB824\uB098?
    \uCD08\uB85D\uC0C9\uC77C\uAE4C\u2026 \uC544\uB2C8\uBA74 \uD30C\uB780\uC0C9\uC77C\uAE4C?"
  - "\uADC0 \uB05D\uC774 \uC870\uAE08\uB9CC \uB354 \uAE38\uC5C8\uC73C\uBA74 \uC88B\uC558\uC744
    \uD150\uB370\u2026 \uADF8\uB7FC \uC9C0\uAE08\uBCF4\uB2E8 \uC778\uAE30 \uC788\uC5C8\uACA0\uC9C0?"
  - "\uC548\uB155.... \uAC00\uC9C0... \uAECD\uC9C8... \uC5F4\uB9E4... \uC788\uB2C8? 
    - \uB098\uBB34\uC815\uB839\uACFC\uC758 \uB300\uD654\uD558\uB294\uBC95(1)"
  - "\uB354 \uAC15\uD574\uC9C8 \uBC29\uBC95\uC774 \uC788\uB2E4\uBA74\u2026 \uC544\uB2C8,
    \uD751\uB9C8\uBC95 \uAC19\uC740 \uAC74 \uC0DD\uAC01\uD558\uC9C0 \uB9D0\uC790."
  - "\uC5B4? \uC720\uB09C\uD788 \uBC18\uC9DD \uAC70\uB9AC\uB294 \uB3CC\uC774\uB124?
    \uC7A5\uB85C\uB2D8\uAED8 \uAC00\uC838\uAC00\uBCF4\uC790!"
  - "\uC6A9\uC758 \uBE44\uB298\uC744 \uAD6C\uD574\uC624\uB77C\uB2C8? \uB098\uBCF4\uACE0
    \uC8FD\uC73C\uB77C\uB294 \uAC70 \uC544\uB2C8\uC57C?"
  - "\uAC00\uB77C, \uBC88\uAC1C \uC815\uB839! 100\uB9CC \uBCFC\uD2B8! - \uC720\uD589\uD558\uB294
    \uC815\uB839 \uBC30\uD2C0"
  - "\uC778\uAC04\uB4E4\uC740 \uC65C \uADF8\uB807\uAC8C \uC57D\uD558\uBA74\uC11C\uB3C4
    \uB05D\uAE4C\uC9C0 \uBC84\uD2F0\uB294 \uAC78\uAE4C\u2026 \uAC00\uB054\uC740 \uC774\uD574\uAC00
    \uC548 \uB3FC."
  - "\uC544\u2026! \uC774\uBC88\uC5D0\uB3C4 \uC2E4\uD328\uC57C! \uBD84\uBA85 \uB808\uC2DC\uD53C\uB300\uB85C
    \uD588\uB294\uB370\u2026"
  - "\uB3D9\uBB3C\uB4E4\uC758 \uC6C0\uC9C1\uC784\uC774 \uC2EC\uC0C1\uCE58 \uC54A\uC544.
    \uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB0A0\uAC8C \uBD84\uBA85\uD574."
  - "\uC544\uC9C1\uC740 \uADF8 \uC774\uC0C1 \uB0A0 \uC218 \uC5C6\uAD6C\uB098... \uC5EC\uAE30\uAE4C\uC9C0\uAC00
    \uD55C\uACC4\uB124"
  - "\uB4DC\uB8E8\uC774\uB4DC, \uB808\uC778\uC800\uB294 \uB9C8\uCE68\uB0B4 \uCD09\uC218
    \uAD34\uBB3C\uB4E4\uC744 \uBB3C\uB9AC\uCE58\uACE0, \uBC1C\uB2E4\uC2A4\uB97C \uB418\uB3CC\uB824\uB193\uC558\uB2E4...
    - \uC778\uAE30 \uC18C\uC124 \uB4DC\uB798\uACE4 \uC564 \uB358\uC804\uC911\uC5D0\uC11C"
