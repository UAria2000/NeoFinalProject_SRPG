%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d756f62a7ec4464999ba9bcb575c632, type: 3}
  m_Name: Human Battle Last Will Text Table
  m_EditorClassIdentifier: Assembly-CSharp::BattleLastWillTextTable
  texts:
  - "\uC774\uB807\uAC8C \uBE44\uAC00 \uC624\uC9C0 \uC54A\uC73C\uBA74 \uACE1\uC2DD\uB4E4\uC774
    \uB2E4 \uC8FD\uC744\uD150\uB370\u2026 \uC2E0\uAED8 \uAE30\uB3C4\uB97C \uC62C\uB9B4
    \uC900\uBE44\uB97C \uD574\uC57C\uACA0\uC5B4."
  - "\uC5B4\uBA38\uB2C8\uC758 \uBCD1\uC138\uAC00 \uC810\uC810 \uC548 \uC88B\uC544\uC9C0\uC2DC\uB294\uB370
    \uBCD1\uC6D0\uBE44\uB294 \uC774\uC81C \uC5B4\uB5BB\uAC8C \uB0B4\uC9C0\u2026"
  - "\uAE38\uC5D0 \uD540 \uAF43\uC774 \uCC38 \uC608\uC058\uB124. \uAC00\uC838\uB2E4\uC8FC\uBA74
    \uC88B\uC544\uD558\uB824\uB098? \uC624\uB298\uC740 \uAF2D \uB9CC\uB098\uC790\uACE0
    \uD574\uC57C\uC9C0."
  - "\uC624\uB298\uB530\uB77C \uBC30\uAC00 \uB9CE\uC774 \uACE0\uD504\uAD70. \uB3C8\uB3C4
    \uB544\uC73C\uB2C8 \uC800\uB141\uC740 \uACE0\uAE30 \uC2A4\uD29C\uB85C \uD560\uAE4C?"
  - "\uC5B4\uC81C \uBCF4\uCD08 \uADFC\uBB34\uB294 \uC815\uB9D0 \uB054\uCC0D\uD588\uC5B4!
    \uC5BC\uAD74\uB9CC\uD55C \uBC8C\uB808\uB77C\uB2C8?!"
  - "\uACB0\uD63C\uC2DD \uB0A0 \uADF8 \uD45C\uC815\uC740 \uB0B4 \uD55C \uD3C9\uC0DD
    \uC78A\uC9C0 \uBABB\uD560 \uAC70\uC57C. \uC0AC\uB791\uD574."
  - "\uD070\uC77C\uC774\uB2E4! \uB0B4 \uACB0\uD63C \uBC18\uC9C0\uAC00 \uC5B4\uB514
    \uAC04 \uAC70\uC9C0?"
  - "\uC544\uB2C8? \uC774\uAC8C \uC6EC \uBC18\uC9C0\uC57C? \uD750\uD750! \uC624\uB298\uC740
    \uAC70\uD558\uAC8C \uB9C8\uC2DC\uC790"
  - "\uBAB9\uC2DC \uC678\uC124\uC2A4\uB7EC\uC6B4 \uC218\uB140\uC640 \uB18D\uC7A5\uC8FC\uC758
    \uADF8\uB9BC\uC774 \uADF8\uB824\uC838 \uC788\uC2B5\uB2C8\uB2E4 -\uC218\uB140\uC640
    \uC6B0\uC720"
  - "\uC774\uBC88 \uC0DD\uC77C\uC5D0\uB294 \uC800\uBC88\uC5D0 \uC598\uAE30\uD55C
    \uC6D0\uD53C\uC2A4\uB97C \uC120\uBB3C\uD574\uC57C\uC9C0. \uB77C\uC784\uC0C9\uC774
    \uC88B\uB2E4\uACE0 \uD588\uC5C8\uC5B4."
  - "\uC7A0\uC744 \uC790\uB3C4\uC790\uB3C4 \uC65C \uC774\uB807\uAC8C \uD53C\uB85C\uD558\uC9C0?
    \uC628\uCC9C\uC774\uB77C\uB3C4 \uB2E4\uB140\uC62C\uAE4C..."
  - "\uC9C0\uAC01\uC774\uB2E4! \uC5B4\uC81C \uB108\uBB34 \uB2A6\uAC8C\uAE4C\uC9C0
    \uB180\uC558\uC5B4!"
  - "\uB0B4\uAC00 \uC655\uB144\uC5D0 \uBB34\uB98E\uC5D0 \uD654\uC0B4\uB9CC \uC548
    \uB9DE\uC558\uC5B4\uB3C4... - \uC804\uC9C1 \uBAA8\uD5D8\uAC00"
  - "\uC774 \uD3B8\uC9C0\uB294 \uC544\uC81C\uB85C\uC2A4\uC5D0\uC11C \uC2DC\uC791\uD558\uC5EC
    \uBC1B\uC740 \uC0AC\uB78C\uC740 3\uBA85\uC5D0\uAC8C\u2026 - \uC815\uCCB4\uBD88\uBA85\uC758
    \uD3B8\uC9C0"
  - "\uBC84\uB514\uB294 \uAD50\uD68C \uC55E \uC5B8\uB355 \uC0B0\uCC45\uC744 \uC88B\uC544\uD574.
    \uC790\uC8FC\uC2DC\uCF1C\uC918 - \uB3D9\uC0DD\uC5D0\uAC8C"
  - "\uC81C\uBC1C \uC774\uBC88 \uC2DC\uD5D8\uC5D0\uB294 \uBD99\uC5C8\uC73C\uBA74..
    - \uC548\uD0C0\uAE4C\uC6B4 \uB9C8\uBC95 \uB099\uC81C\uC0DD"
  - "\uC624\uB298\uC740 \uB9DB\uC788\uB294 \uC694\uB9AC\uB97C \uD574\uC904\uAE4C?
    \uC694\uC998 \uAE30\uC6B4\uC774 \uB108\uBB34 \uC5C6\uC5B4\uBCF4\uC774\uB358\uB370!"
  - "\uBE4C\uC5B4\uBA39\uC744.. \uACBD\uB9C8\uC7A5\uC740 \uC0AC\uAE30\uC57C! \uBAA8\uB450
    \uD55C\uD1B5\uC18D\uC774\uB77C\uACE0! - \uC5B4\uB290 \uBA38\uC800\uB9AC"
  - "\uB2EC\uC774 \uBD89\uC740\uC0C9\uC774\uB77C\uB2C8! \uBB34\uC2A8 \uD070\uC77C\uC774
    \uB0A0\uAC8C \uBD84\uBA85\uD574! \uC2E0\uC774 \uB178\uD558\uC2E0\uAC70\uC57C!"
  - "\uC800 \uBC14\uB2E4 \uB108\uBA38\uC5D0\uB294 \uB2E4\uB978 \uC138\uC0C1\uC774
    \uC788\uACA0\uC9C0? \uC9C0\uAE0B\uC9C0\uAE0B\uD55C \uC774\uACF3\uC744 \uB5A0\uB098\uACE0
    \uC2F6\uC5B4!"
  - "\uC544~ \uB3C8\uC774 \uBE44\uCC98\uB7FC \uC3DF\uC544\uC9C4\uB2E4\uBA74 \uC5BC\uB9C8\uB098
    \uC88B\uC744\uAE4C~"
  - "\uB0B4\uAC00 \uB3C8 \uC0DD\uAE30\uBA74 \uAF2C\uBC15\uAF2C\uBC15 \uAC1A\uACA0\uB2E4\uB294\uB370
    \uC65C \uB09C\uB9AC\uC57C?!"
  - "2\uB2EC\uCE58 \uC678\uC0C1 \uAC1A\uAE30 \uC804\uAE4C\uC9C0\uB294 \uCD9C\uC785
    \uAE08\uC9C0! - \uB3CC\uACE0\uB798 \uC8FC\uC810 -\n\uBC11\uC5D0\uB294 \uC5EC\uB7EC
    \uC774\uB984\uACFC \uC561\uC218\uAC00 \uC794\uB729 \uC801\uD600 \uC788\uC2B5\uB2C8\uB2E4"
